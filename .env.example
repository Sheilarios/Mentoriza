# ===== Mentoriza · variables de entorno =====
# Copia este archivo como .env y completa los valores.

# Base de datos PostgreSQL (docker compose la define sola; para otros despliegues pon la tuya)
DATABASE_URL="postgresql://mentoriza:mentoriza@localhost:5432/mentoriza?schema=public"
POSTGRES_PASSWORD=mentoriza

# Seguridad: cadena larga y aleatoria (obligatoria en producción)
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_EXPIRES_IN=7d

# Dominios permitidos para la API si el frontend está en otro dominio (separados por coma). Vacío = cualquiera.
CORS_ORIGIN=

# IA compatible con OpenAI (OpenAI, Groq, OpenRouter, Azure OpenAI, Ollama...).
# Sin AI_API_KEY la plataforma funciona con guías locales básicas.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Pagos: "demo" registra pagos sin cobrar (fase beta)
PAYMENTS_MODE=demo

# Cuentas iniciales (se crean una sola vez al arrancar)
ADMIN_EMAIL=admin@mentoriza.pe
ADMIN_PASSWORD=cambia-esta-clave
SEED_UNI_ACCESS_CODE=mentoriza2026
SEED_DEMO_PASSWORD=mentoriza2026

# Cuentas de prueba visibles debajo del inicio de sesión (estudiante, estudiante gratis, mentor y universidad).
# Ponlo en false cuando lances con usuarios reales.
DEMO_ACCOUNTS=true
